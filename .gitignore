# Generated by the verification suites on every run.
# Fixtures are seeded and deterministic (see _verify/fixtures.mjs), so they are
# reproducible and do not need to be committed. Ignoring them keeps the repo at
# a few hundred KB instead of 90 MB.
_verify/fixtures/
_verify/.mutation-fixtures/
_verify/shots/

# Redundant historical transcripts — full_run.txt is the canonical one.
_verify/full_run_run*.txt

# OS / editor noise
.DS_Store
Thumbs.db
*.log
